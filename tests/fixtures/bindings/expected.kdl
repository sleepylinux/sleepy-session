binds {
    Mod+Return { spawn "ghostty"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
    Mod+D { spawn "fuzzel"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    Mod+L { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "requestSessionAction" "lock"; }
    Mod+Shift+E { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "requestSessionAction" "logout"; }
    Mod+P { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "openPowerMenu"; }
    Mod+Shift+P { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "requestSessionAction" "powerOff"; }
    Mod+Shift+R { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "requestSessionAction" "reboot"; }
    Mod+C { spawn "quickshell" "ipc" "--config" "sleepy" "call" "sleepy" "toggleControlCenter"; }
    Mod+Q { close-window; }
    Mod+Down { focus-window-down; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
}
